{
  "name": "@maschinenlesbar.org/fim-portal-client",
  "version": "0.0.1",
  "private": true,
  "description": "The typed API client of fim-portal-cli. Not published on its own: bundled into @maschinenlesbar.org/fim-portal-cli, whose library entry re-exports it.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./internal/*": {
      "types": "./dist/src/*.d.ts",
      "import": "./dist/src/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Sebastian Schürmann <sebs@2xs.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maschinenlesbar-org/fim-portal-cli.git",
    "directory": "packages/client"
  },
  "homepage": "https://maschinenlesbar.org/fim-portal-cli/"
}
