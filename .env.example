# Kopieren nach .env und ausfüllen (.env ist in .gitignore). Laden z. B. mit: set -a; source .env; set +a
# Nur die Keys der Anbieter eintragen, die du testen willst.
MISTRAL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Eigener OpenAI-kompatibler Endpunkt für examples/llm_chat.py --anbieter eigen
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Server
ZF_USER_AGENT="MeinProjekt/1.0 (kontakt: team@example.org)"
# Datenquellen (Dateien oder Ordner, kommagetrennt). Standard: Ordner quellen/
# ZF_QUELLEN=quellen,../meine-quellen
# Zugangsdaten eines geschützten WFS, Name frei wählbar und in der Quelle als auth_env eingetragen
# ZF_BZB_EIGEN_AUTH=benutzer:passwort
